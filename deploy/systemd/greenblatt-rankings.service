[Unit]
Description=Compute Greenblatt Magic Formula rankings
Documentation=file:///home/caudillo/Value_Investing/backend/methodologies/greenblatt/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/caudillo/Value_Investing
Environment="PATH=/home/caudillo/Value_Investing/.venv/bin:/usr/bin"
EnvironmentFile=-/home/caudillo/Value_Investing/.env
ExecStart=/home/caudillo/Value_Investing/.venv/bin/python -m scripts.compute_greenblatt_rankings --universe sp500
StandardOutput=append:/home/caudillo/Value_Investing/data/logs/greenblatt_rankings.log
StandardError=append:/home/caudillo/Value_Investing/data/logs/greenblatt_rankings.log
