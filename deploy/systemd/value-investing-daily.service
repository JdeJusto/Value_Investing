# Value Investing — daily workflow (systemd user unit).
#
# Install per-user and enable (the timer is what schedules the run):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/value-investing-daily.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now value-investing-daily.timer
#   systemctl --user list-timers value-investing-daily.timer
#   systemctl --user start value-investing-daily.service     # run once now
#
# SEC_USER_AGENT is intentionally NOT set here: it must contain a real
# e-mail address and belongs in the gitignored .env (loaded through
# EnvironmentFile below). Without it the targeted SEC refresh is skipped,
# not failed — see docs/runbook_daily.md.
#
# The run checkpoints every completed ticker in
# data/reports/daily_run_state.json (atomic writes), so stop/restart/power
# loss resume automatically: --resume is the default and completed tickers
# are not SEC-refreshed again.

[Unit]
Description=Value Investing Daily Workflow
Documentation=file://%h/Value_Investing/docs/runbook_daily.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Value_Investing
Environment="PATH=%h/Value_Investing/.venv/bin:/usr/bin"
# 127.0.0.1 avoids depending on the resolver for the database connection;
# .env may still override FINANCIAL_DATABASE_URL for a remote database.
Environment="FINANCIAL_DATABASE_URL=postgresql://financial@127.0.0.1:5432/financial_database"
# Wait up to 60s for PostgreSQL before giving up, and fail loudly instead of
# silently falling back to the legacy JSON store (incomplete coverage).
Environment="FDB_READY_TIMEOUT_SECONDS=60"
Environment="VI_REQUIRE_FDB=1"
# Optional: repo .env (same keys) — the leading '-' tolerates a missing file
EnvironmentFile=-%h/Value_Investing/.env
# A persistent timer fires seconds after boot, before PostgreSQL and DNS are
# ready (observed 2026-11-01/02/03). Wait for both, up to 5 minutes, so the run
# never starts against a half-initialized host.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 150); do pg_isready -h 127.0.0.1 -p 5432 -q && getent hosts data.sec.gov >/dev/null 2>&1 && getent hosts query1.finance.yahoo.com >/dev/null 2>&1 && exit 0; sleep 2; done; echo "PostgreSQL/DNS not ready after 300s" >&2; exit 1'
# --verbose so the scheduled log carries the stage progress, phase timings,
# fundamentals-cache stats and network telemetry (WARNING-only otherwise).
ExecStart=%h/Value_Investing/.venv/bin/python -m scripts.daily_workflow --universe all --max-refresh 200 --top 20 --resume --verbose
StandardOutput=append:%h/Value_Investing/data/logs/daily_workflow.log
StandardError=append:%h/Value_Investing/data/logs/daily_workflow.log
# Hours-long runs must never time out; stopping sends SIGTERM so the
# workflow can finish the current ticker, flush its state and exit 0.
TimeoutStartSec=0
TimeoutStopSec=600
KillSignal=SIGTERM
Restart=no
# Desktop-friendly scheduling
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
