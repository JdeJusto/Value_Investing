# SEC EDGAR identity (required for SEC API access)
SEC_EMAIL="your-email@example.com"
SEC_NAME="Your Name"

# User-Agent sent on every SEC request (Financial-DataBase ingestion + the
# daily workflow's targeted refresh). A descriptive agent with a real email
# domain is mandatory. NEVER use a github.com address (SEC answers HTTP 403
# for the github.com domain family, including users.noreply.github.com) —
# see Financial-DataBase docs/sec_403_investigation.md
SEC_USER_AGENT="FinancialDataBase/1.0 your-email@example.com"

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/value_investing"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/value_investing"

# Redis
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# JWT Security
SECRET_KEY="change-me-in-production-use-a-strong-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:80"

# Output directory
OUTPUT_DIR="outputs"

# Default financial assumptions
DEFAULT_TAX_RATE="0.21"
DEFAULT_WACC="0.08"
DEFAULT_MARKET_RETURN="0.10"
DEFAULT_GROWTH_RATE="0.05"
DEFAULT_TERMINAL_GROWTH="0.02"
DCF_PROJECTION_YEARS="5"

# Cache TTL (seconds)
FINANCIAL_CACHE_TTL="900"
ANALYSIS_CACHE_TTL="3600"

# Financial-DataBase integration (optional)
# Where the normalized SEC fundamentals live. The daily workflow reads
# fundamentals from here and never writes to it. Leave unset to fall back to
# the JSON repository; the tests that need it skip when it is absent.
# Local development default (user/password are not secrets); change them for
# anything beyond localhost.
FINANCIAL_DATABASE_URL="postgresql://financial:test@localhost:5432/financial_database"

# Yahoo Finance preflight (optional)
# User-Agent used by the availability probe. Yahoo answers HTTP 429 to a
# browser-like agent from many hosts while a minimal agent is served, so the
# default is deliberately plain — see docs/price_recovery_2026-09-28.md.
# YAHOO_HEALTH_USER_AGENT="Mozilla/5.0"
# YAHOO_HEALTH_TTL_SECONDS="120"
# YAHOO_HEALTH_TIMEOUT_SECONDS="5"

# Yahoo 429 watcher (optional)
# Consecutive daily runs with a failed Yahoo preflight before the report
# raises an alert (config/alerts.yaml).
# YAHOO_429_STREAK_THRESHOLD="3"

# Scheduled SEC refresh (optional, see config/refresh.yaml)
# REFRESH_AUTO="true"
# FRESHNESS_MAX_AGE_HOURS="168"
# REFRESH_TIMEOUT_SECONDS="300"
# REFRESH_WORKERS="2"

# Fundamentals cache (optional)
# Set to 0 to ignore data/cache/analysis and re-read every company.
# ANALYSIS_CACHE="1"

# REST API (optional; see docs/api_design.md and roadmap issue #27)
# Generate API_KEY with: openssl rand -hex 32
# The API refuses protected requests with 503 until API_KEY is set.
API_HOST="127.0.0.1"
API_PORT="8000"
API_KEY=""
API_ENABLE_DOCS="true"
API_CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"
