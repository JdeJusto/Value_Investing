# SEC EDGAR identity (required for SEC API access)
SEC_EMAIL="your-email@example.com"
SEC_NAME="Your Name"

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/value_investing"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/value_investing"

# Redis
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# JWT Security
SECRET_KEY="change-me-in-production-use-a-strong-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:80"

# Output directory
OUTPUT_DIR="outputs"

# Default financial assumptions
DEFAULT_TAX_RATE="0.21"
DEFAULT_WACC="0.08"
DEFAULT_MARKET_RETURN="0.10"
DEFAULT_GROWTH_RATE="0.05"
DEFAULT_TERMINAL_GROWTH="0.02"
DCF_PROJECTION_YEARS="5"

# Cache TTL (seconds)
FINANCIAL_CACHE_TTL="900"
ANALYSIS_CACHE_TTL="3600"
