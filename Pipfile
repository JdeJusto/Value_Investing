[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
yfinance = ">=0.2.50"
pandas = ">=2.2.0"
numpy = ">=2.0.0"
edgartools = ">=5.0.0"
python-dotenv = ">=1.0.0"
sqlalchemy = ">=2.0"
psycopg2-binary = ">=2.9"
# Imported by backend/services/sql_analysis_service.py. It was installed in the
# working venv but missing here, so a fresh `pipenv install` produced a
# project whose SQL analysis service could not even be imported.
sqlparse = ">=0.5"
streamlit = "*"
gitpython = ">=3.1.59"
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
celery = {extras = ["redis"], version = "*"}
passlib = {extras = ["bcrypt"], version = "*"}
pyjwt = {extras = ["crypto"], version = ">=2.8"}
pydantic = {extras = ["email"], version = "*"}
pydantic-settings = "*"
httpx = "*"
redis = "*"
alembic = "*"
asyncpg = "*"
bcrypt = "==4.0.1"
beautifulsoup4 = ">=4.15"
lxml = ">=6.0"
# Terminal rendering (tables, panels, spinners) for the CLI. Pure Python, no
# C extensions; it is the only output-formatting dependency (no colorama).
rich = ">=14.0"

[dev-packages]
black = ">=25.0"
isort = ">=6.0"
flake8 = ">=7.0"
pytest = ">=8.0"
alembic = ">=1.13"

[scripts]
ui = "streamlit run ui/app.py"

[requires]
python_version = ">=3.13"
